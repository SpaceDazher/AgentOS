  "schemas": {
    "session": {
      "$id": "agentos.s1-013.session-schema/v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "S1-013 pilot session record",
      "description": "One participant session. No PII, no contacts, no verbatim answers beyond coded responses. Synthetic sessions carry synthetic=true and never enter human counts.",
      "type": "object",
      "required": [
        "session_id",
        "participant_id",
        "role",
        "protocol_version",
        "cohort",
        "started_at",
        "synthetic",
        "consent",
        "contract_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^S-[A-Z0-9-]{1,40}$"
        },
        "participant_id": {
          "type": "string",
          "pattern": "^P-[0-9A-Z]{6}$",
          "description": "Random pseudonymous id; reidentification key held by operator only, never in Git"
        },
        "role": {
          "enum": [
            "owner",
            "reviewer"
          ]
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "cohort": {
          "enum": [
            "human",
            "synthetic"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "excluded": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exclusion reason code or null; excluded sessions stay in the flow denominator"
        },
        "consent": {
          "type": "object",
          "required": [
            "given",
            "version"
          ],
          "properties": {
            "given": {
              "type": "boolean"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "$id": "agentos.s1-013.events-schema/v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "S1-013 pilot event log",
      "description": "Ordered session events. The prototype, exporter, evaluator and analyst share these exact event names; any other name is rejected at import.",
      "type": "object",
      "required": [
        "session_id",
        "events"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "seq",
              "t_ms",
              "type"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "t_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Milliseconds since session start (task timing moments)"
              },
              "type": {
                "enum": [
                  "prompt_displayed",
                  "decision",
                  "answer",
                  "stop_requested",
                  "stop_confirmed",
                  "stop_failed",
                  "fatigue_report",
                  "debrief_done",
                  "block_started",
                  "block_paused",
                  "block_resumed",
                  "block_ended",
                  "withdrawn"
                ]
              },
              "prompt_id": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "decision": {
                "enum": [
                  "approve",
                  "deny",
                  "abstain",
                  null
                ],
                "default": null
              },
              "correct": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null,
                "description": "Scenario-oracle correctness, set by scorer only"
              },
              "actor_shown": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "action_shown": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "scope_shown": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "expiry_shown": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "acknowledged": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null,
                "description": "Stop acknowledgement outcome (C5 must reach confirmed stop)"
              },
              "block_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fatigue": {
                "enum": [
                  "ok",
                  "tired",
                  "stop",
                  null
                ]
              },
              "acknowledgements": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "required": [
                    "agent_id",
                    "state"
                  ],
                  "properties": {
                    "agent_id": {
                      "type": "string"
                    },
                    "state": {
                      "enum": [
                        "stopped",
                        "pending"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "answers": {
      "$id": "agentos.s1-013.answers-schema/v1",
