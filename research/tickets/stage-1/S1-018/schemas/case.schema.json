{
  "$id": "agentos.s1-018.case/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S1-018 scenario case (canonical input)",
  "type": "object",
  "required": ["case_id", "class", "description", "inputs", "transitions"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" },
    "class": { "type": "string", "enum": ["mls_lifecycle", "attestation", "revocation_cache", "leakage_unknown"] },
    "description": { "type": "string", "minLength": 1 },
    "inputs": { "type": "object" },
    "transitions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
